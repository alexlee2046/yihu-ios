      "zh-Hans": { "stringUnit": { "state": "translated", "value": "语音输入" } }
    } },
    "语音只在这台 iPhone 上识别，不会上传。": { "extractionState": "manual", "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Voice input is transcribed on this iPhone. Audio is not uploaded." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "语音只在这台 iPhone 上识别，不会上传。" } }
    } },
    "删除语音模型？": { "extractionState": "manual", "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Delete the voice model?" } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除语音模型？" } }
    } },
    "删除": { "extractionState": "manual", "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Delete" } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除" } }
    } },
    "可释放约 950 MB 空间。之后使用语音输入需要重新下载。": { "extractionState": "manual", "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Frees about 950 MB. You'll need to download it again to use voice input." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "可释放约 950 MB 空间。之后使用语音输入需要重新下载。" } }
    } },
    "正在检查…": { "extractionState": "manual", "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Checking…" } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在检查…" } }
    } },
    "未下载（约 950 MB）": { "extractionState": "manual", "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Not downloaded (about 950 MB)" } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "未下载（约 950 MB）" } }
    } },
    "正在下载 %lld%%": { "extractionState": "manual", "localizations": {
