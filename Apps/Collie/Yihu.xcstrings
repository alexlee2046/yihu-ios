    "WeSpeaker 暂继续用于填入前确认；CAM++ 仅作本机对照候选。两模型的实际得分可在下方测试页查看，不能直接比较分数高低。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeSpeaker remains the check before insertion; CAM++ is only a local comparison candidate. View their scores on the test page below. Scores from the two models are not directly comparable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeSpeaker 暂继续用于填入前确认；CAM++ 仅作本机对照候选。两模型的实际得分可在下方测试页查看，不能直接比较分数高低。"
          }
        }
      }
    },
    "声纹测试（两模型得分）": {
      "extractionState": "manual",
