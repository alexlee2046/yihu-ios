  "strings": {
    "返回工作台": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to workbench"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回工作台"}}}},
    "全部工作台": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All workbenches"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全部工作台"}}}},
    "自定义快捷入口": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Customize shortcuts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义快捷入口"}}}},
    "首页快捷入口": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Home shortcuts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首页快捷入口"}}}},
    "拖动排序，移除只隐藏快捷入口，不删除工作台。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Drag to reorder. Removing a shortcut hides it without deleting the workbench."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拖动排序，移除只隐藏快捷入口，不删除工作台。"}}}},
    "可添加的工作台": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Available workbenches"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可添加的工作台"}}}},
    "搜索项目与待办": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search projects and actions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索项目与待办"}}}},
    "不是有效的 PM Radar 快照。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This is not a valid PM Radar snapshot."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不是有效的 PM Radar 快照。"}}}},
    "代码动态": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Code activity"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"代码动态"}}}},
    "代码更新时间仅供参考，不代表任务停工或完成。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Commit dates are context, not evidence that a task stopped or finished."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"代码更新时间仅供参考，不代表任务停工或完成。"}}}},
    "删除雷达工作台？": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this radar workspace?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除雷达工作台？"}}}},
    "刷新": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新"}}}},
    "取消收藏": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Unfavorite"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消收藏"}}}},
    "只删除本机配置和快照，不改变服务器台账。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only local settings and snapshots are removed. Server records are unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只删除本机配置和快照，不改变服务器台账。"}}}},
    "名称": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Name"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"名称"}}}},
    "导入 pm-radar --json 快照，或设置你自己的 HTTPS JSON 数据源。不会自动连接开发者的私人台账。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Import a pm-radar --json snapshot or configure your own HTTPS JSON feed. No developer's private ledger is connected automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入 pm-radar --json 快照，或设置你自己的 HTTPS JSON 数据源。不会自动连接开发者的私人台账。"}}}},
    "导入快照": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Import snapshot"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入快照"}}}},
    "工作台操作": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Workspace actions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工作台操作"}}}},
    "工作台配置无法读取，原始配置已保留。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Workspace settings could not be read. The original settings were preserved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工作台配置无法读取，原始配置已保留。"}}}},
    "待我处理": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Needs my action"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待我处理"}}}},
    "快照不能超过 2 MB。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Snapshots must be no larger than 2 MB."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快照不能超过 2 MB。"}}}},
    "快照已过期，请刷新或重新导入。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This snapshot is outdated. Refresh or import a newer one."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快照已过期，请刷新或重新导入。"}}}},
    "任务状态未提供": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Task status not provided"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"任务状态未提供"}}}},
    "总览": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Overview"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"总览"}}}},
    "所有项目": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All projects"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有项目"}}}},
    "支持 pm-radar --json 格式。需要登录的数据源暂请导出快照后导入；不会复制网页 Cookie 或向其他站点转发凭据。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Supports pm-radar --json. For feeds requiring login, export and import a snapshot. Browser cookies are not copied and credentials are not forwarded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支持 pm-radar --json 格式。需要登录的数据源暂请导出快照后导入；不会复制网页 Cookie 或向其他站点转发凭据。"}}}},
    "收藏": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Favorites"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收藏"}}}},
    "收藏工作台": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Favorite workspace"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收藏工作台"}}}},
    "数据源": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Data source"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据源"}}}},
    "数据源返回 HTTP %d，原有快照已保留。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The feed returned HTTP %d. The previous snapshot was preserved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据源返回 HTTP %d，原有快照已保留。"}}}},
