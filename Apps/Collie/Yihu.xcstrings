      "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在下载 %lld%%" } }
    } },
    "下载未完成": { "extractionState": "manual", "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Download incomplete" } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "下载未完成" } }
    } },
    "无法加载": { "extractionState": "manual", "localizations": {
