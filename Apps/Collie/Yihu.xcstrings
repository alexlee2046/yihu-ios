{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "已读取范围内暂无对应处理反馈。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No corresponding handling feedback in the records loaded so far."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读取范围内暂无对应处理反馈。"
          }
        }
      }
    },
    "明确引用此回复的后续备注": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later notes explicitly referencing this reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确引用此回复的后续备注"
          }
        }
      }
    },
    "当前服务不支持历史回显，请查看原条目。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This service does not support history yet. Open the original item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前服务不支持历史回显，请查看原条目。"
          }
        }
      }
    },
    "当前身份无权读取此历史，请核对原数据源权限。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This identity cannot read this history. Check permissions on the original source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前身份无权读取此历史，请核对原数据源权限。"
          }
        }
      }
    },
    "条目已不在当前台账或不可见，历史暂不可用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item is outside this ledger or no longer visible. History is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目已不在当前台账或不可见，历史暂不可用。"
          }
        }
      }
    },
    "来源或分页范围已变化，请重新读取历史。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source or page range changed. Reload history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源或分页范围已变化，请重新读取历史。"
          }
        }
      }
    },
    "历史读取失败，已显示的记录和输入保留；请重试或查看原条目。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History could not be read. Displayed records and your input are retained. Retry or open the original item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史读取失败，已显示的记录和输入保留；请重试或查看原条目。"
          }
        }
      }
    },
    "来源已变化，请关闭后重新打开；原输入仍保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed. Close and reopen this view; your input is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源已变化，请关闭后重新打开；原输入仍保留。"
          }
        }
      }
    },
