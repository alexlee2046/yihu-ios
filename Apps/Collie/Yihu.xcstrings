          }
        }
      }
    },
    "原生连接 OpenClaw 网页控制台，用端侧离线语音代替手机小屏敲字，支持锁屏长录音转写与系统分享截图上传。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your OpenClaw web console natively. Dictate into your chat input with on-device speech, hand off lock-screen voice notes, and attach screenshots from the iOS Share Sheet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生连接 OpenClaw 网页控制台，用端侧离线语音代替手机小屏敲字，支持锁屏长录音转写与系统分享截图上传。"
          }
        }
      }
    },
    "在运行 OpenClaw 的主机开启 HTTPS 访问（例如运行 tailscale serve --bg 18789，或使用 Caddy / Cloudflare Tunnel 映射 HTTPS 域名）。": {
      "extractionState": "manual",
      "localizations": {
