    },
    "使用本机麦克风录制不同环境的多句短语。显示每句与本人基准的余弦得分；不同模型没有统一阈值，需用真实本人及他人声音数据校准。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record several phrases in different settings using this device. Each cosine score compares a phrase with your enrolled reference. Models have no shared threshold; calibration requires real samples from you and other speakers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本机麦克风录制不同环境的多句短语。显示每句与本人基准的余弦得分；不同模型没有统一阈值，需用真实本人及他人声音数据校准。"
          }
        }
      }
    },
