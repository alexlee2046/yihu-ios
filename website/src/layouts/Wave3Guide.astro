---
import Layout from './Layout.astro';
import Demo from '../components/Demo';
import GuideQuickCheck from '../components/GuideQuickCheck.astro';
import { guideConversion } from '../lib/conversion-events';
interface Props {
  frontmatter: { title: string; description: string; lang: 'zh' | 'en'; indexable?: boolean; quickCheck?: 'audio' | 'notes'; preview?: 'voice' | 'audio' | 'radar'; voiceSample?: 'web' | 'meeting' };
}
const { title, description, lang, indexable = true, preview, voiceSample, quickCheck } = Astro.props.frontmatter;
const home = lang === 'en' ? '/en/' : '/';
const conversion = guideConversion(Astro.url.pathname);
const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
const pillar = /model-artifact|app-group/.test(slug) ? 'iphone-agent-voice-drafts' : /radar|reply|history|attention|status|evidence/.test(slug) ? 'multi-project-radar-watch' : /audio|bluetooth|voiceprint|pcm|capture|microphone|interruption|recognition/.test(slug) ? 'bluetooth-audio-input-troubleshooting' : /note|minutes|brief|transcript|recording|archive/.test(slug) ? 'recording-notes-handoff' : 'iphone-agent-voice-drafts';
---
<Layout title={title} description={description} lang={lang} indexable={indexable}>
  <article class:list={['document', 'wave3-guide', { 'task-document': preview || quickCheck }]}>
    <nav class="guide-context" aria-label={lang === 'en' ? 'Guide context' : '指南归属'}><a href={`${home}#scenarios`}>{lang === 'en' ? 'All scenarios' : '场景指南'}</a>{slug !== pillar && <> · <a href={`${home}guides/${pillar}/`}>{lang === 'en' ? 'Related practical guide' : '相关使用指南'}</a></>}</nav>
    {!indexable && <p class="reference-label">{lang === 'en' ? 'Technical reference · for existing users' : '技术参考 · 供现有用户查阅'}</p>}
    <h1>{title}</h1>
    {quickCheck && <GuideQuickCheck lang={lang} task={quickCheck} />}
    {conversion && <section class="guide-conversion" data-guide-conversion aria-label={lang === 'en' ? 'Try a sample or view the store edition' : '先试示例或查看商店版'}>
      <p>{conversion.sourceContext}</p>
      <div class="hero-actions"><a class="button button-primary" href={conversion.demoHref}>{conversion.demoLabel}</a><a class="button button-text app-store-link" href={conversion.storeHref}>{conversion.storeLabel}</a></div>
      <p>{conversion.storeContext}</p>
    </section>}
    {preview && <><p class="lead">{description}</p><Demo client:visible lang={lang} initialScene={preview} initialVoiceSample={voiceSample} /></>}
    <slot />
  </article>
</Layout>
<style is:global>
  .wave3-guide { overflow-wrap:anywhere; }
  .wave3-guide [role="region"] { max-width:100%; overflow-x:auto; margin-block:24px; }
  .wave3-guide [role="region"]:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .wave3-guide table { width:100%; min-width:640px; border-collapse:collapse; text-align:start; }
  .wave3-guide th, .wave3-guide td { padding:12px; min-width:160px; border-bottom:1px solid var(--line); vertical-align:top; }
  .wave3-guide h2 { scroll-margin-top:100px; }
  .wave3-guide pre { max-width:100%; overflow-x:auto; }
</style>
