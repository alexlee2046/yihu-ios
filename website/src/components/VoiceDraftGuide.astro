---
<article class="document voice-guide">
  <style is:inline>
    .voice-guide { max-width: 1120px; }
    .voice-guide > h1 { max-width: 26ch; font-size: clamp(36px, 4vw, 56px); }
    .voice-guide > p, .voice-guide > ul, .voice-guide > ol { max-width: 78ch; }
    .voice-guide nav { display:flex; flex-wrap:wrap; gap:8px 24px; padding-block:16px; }
    .voice-guide nav a { display:inline-flex; align-items:center; min-height:44px; }
    .voice-guide .table-region { overflow-x:auto; }
    .voice-guide table { width:100%; min-width:1000px; table-layout:fixed; border-collapse:collapse; text-align:start; }
    .voice-guide th, .voice-guide td { padding:16px; border-bottom:1px solid var(--line); vertical-align:top; overflow-wrap:anywhere; text-align:start; }
    .voice-guide th { font-weight:600; }
    .voice-guide th:first-child { width:20%; }
    .voice-guide .walkthrough-table { min-width:900px; }
    .voice-guide .walkthrough-table th:first-child { width:30%; }
    .voice-guide .walkthrough-table tbody th { font-weight:400; }
    .voice-guide td { color:var(--muted); }
    .voice-guide caption { text-align:start; margin-bottom:12px; }
    .voice-guide .table-hint { font-size:13px; }
  </style>
  <h1>{copy.title}</h1>
  <p class="lead">{copy.lead}</p>
  <nav aria-label={copy.nav}>
    <a href="#choose">{copy.decisionTitle}</a><a href="#compare">{copy.comparisonTitle}</a><a href="#walkthrough">{copy.walkthroughTitle}</a><a href="#sources">{copy.sourcesTitle}</a>
  </nav>
  <h2 id="choose">{copy.decisionTitle}</h2>
  <ul>{copy.decisions.map(text => <li>{text}</li>)}</ul>
  <h2 id="compare">{copy.comparisonTitle}</h2>
  <p class="table-hint" id="comparison-hint">{copy.tableHint}</p>
  <div class="table-region" role="region" aria-label={copy.comparisonTitle} aria-describedby="comparison-hint" tabindex="0">
    <table>
      <caption>{copy.comparisonTitle}</caption>
      <thead><tr>{copy.columns.map(text => <th scope="col">{text}</th>)}</tr></thead>
      <tbody>{copy.rows.map(([id, label, system, notes, native]) => <tr id={`compare-${id}`}>
        <th scope="row">{label}</th><td>{system}</td><td>{notes}</td><td>{native}</td>
      </tr>)}</tbody>
    </table>
  </div>
  <h2 id="notes">{copy.notesTitle}</h2>
  {copy.notes.map(text => <p>{text}</p>)}
  <h2 id="walkthrough">{copy.walkthroughTitle}</h2>
  <p>{copy.walkthroughIntro}</p>
  <p><strong>{copy.demoLabel}:</strong> <q>{copy.synthetic}</q></p>
  <p class="table-hint" id="walkthrough-hint">{copy.tableHint}</p>
  <div class="table-region" role="region" aria-label={copy.walkthroughTitle} aria-describedby="walkthrough-hint" tabindex="0">
    <table class="walkthrough-table">
      <caption>{copy.walkthroughTitle}</caption>
      <thead><tr>{copy.stepColumns.map(text => <th scope="col">{text}</th>)}</tr></thead>
      <tbody>{copy.steps.map(([id, title, action, success, failure]) => <tr id={`step-${id}`}>
        <th scope="row"><strong>{title}</strong><br />{action}</th><td>{success}</td><td>{failure}</td>
      </tr>)}</tbody>
    </table>
  </div>
  <h2 id="limits">{copy.limitsTitle}</h2>
  <ul>{copy.limits.map(text => <li>{text}</li>)}</ul>
  <h2 id="sources">{copy.sourcesTitle}</h2>
