---
import answers from '../data/home-answers.json';
interface Props { lang?: 'zh' | 'en'; part: 'intro' | 'details' }
const { lang = 'zh', part } = Astro.props;
const copy = answers[lang];
const home = lang === 'en' ? '/en/' : '/';
---
{part === 'intro' ? <section class="answers-intro wrap" id="first-answer" aria-labelledby="answer-title">
  <h2 id="answer-title">{copy.heading}</h2>
  <p>{copy.answer}</p>
</section> : <section class="answers wrap" aria-labelledby="capabilities-title">
  <h2 id="capabilities-title">{copy.caption}</h2>
  <p class="table-hint" id="table-hint">{lang === 'en' ? 'Swipe the table to compare prerequisites. With a keyboard, focus the table and use the arrow keys.' : '左右滑动表格，查看完整使用前提。键盘用户可聚焦表格后使用方向键。'}</p>
  <div class="table-scroll" role="region" aria-label={copy.caption} aria-describedby="table-hint" tabindex="0">
    <table>
      <thead><tr>{copy.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
      <tbody>{copy.rows.map(row => <tr id={`capability-${row.id}`}><th scope="row">{row.name}</th><td>{row.scope}</td><td>{row.boundary}</td></tr>)}</tbody>
    </table>
  </div>
  <div class="faq-section">
    <h2 id="faq">{copy.faqHeading}</h2>
    <div class="faq-list">{copy.faqs.map(faq => <details class="faq-item"><summary><h3>{faq.question}</h3></summary><div id={`faq-${faq.id}`} class="faq-answer"><p>{faq.answer}</p></div></details>)}</div>
  </div>
  <div class="answer-links"><a href={`${home}start/`}>{copy.start}<img src="/icons/arrow-up-right.svg" width="18" height="18" alt="" /></a><a href={`${home}privacy/`}>{copy.privacy}<img src="/icons/arrow-up-right.svg" width="18" height="18" alt="" /></a><a href={`${home}guides/voice-workbench-vs-radio-chat/`}>{lang === 'en' ? 'Voice workbench, radio or group chat?' : '工作台、对讲机与语音群聊选型'}</a><a href={`${home}guides/outdoor-store-voice-preflight/`}>{lang === 'en' ? 'Outdoor/store audio checks and text handoff' : '户外与门店：音频预检和文字交接'}</a><a href={`${home}guides/bluetooth-audio-input-troubleshooting/`}>{lang === 'en' ? 'Bluetooth input troubleshooting' : '蓝牙输入分层排障'}</a><a href={`${home}guides/offline-workbench-handoff-troubleshooting/`}>{lang === 'en' ? 'Offline and weak-network handoff' : '离线与弱网交接排障'}</a><a href={`${home}guides/meeting-notes-brief-fields/`}>{lang === 'en' ? 'Reviewable minutes and brief fields' : '可核对纪要与简报字段'}</a><a href={`${home}guides/web-read-aloud-microphone-boundaries/`}>{lang === 'en' ? 'Web read-aloud and microphone transitions' : '网页朗读与麦克风切换边界'}</a><a href={`${home}guides/multi-note-review-handoff/`}>{lang === 'en' ? 'Multiple-note review and candidate to-dos' : '多段笔记汇总与待办核对'}</a><a href={`${home}guides/radar-json-null-validation/`}>{lang === 'en' ? 'Radar JSON types and null checks' : 'Radar JSON类型与空值核对'}</a><a href={`${home}guides/first-trial-go-no-go-checklist/`}>{lang === 'en' ? 'Pre-trial go/no-go decision card' : '首次试用继续/停止评估卡'}</a><a href={`${home}guides/recording-segment-review-labels/`}>{lang === 'en' ? 'Review labels within one recording' : '单录音片段标签与语义核对'}</a><a href={`${home}guides/radar-snapshot-batch-comparison/`}>{lang === 'en' ? 'Compare authorized Radar batches' : 'Radar同源批次人工比较'}</a><a href={`${home}guides/noisy-transcript-text-correction/`}>{lang === 'en' ? 'Manual text correction and retained copies' : '人工文本修订与副本核对'}</a><a href={`${home}guides/department-minutes-ownership-archive/`}>{lang === 'en' ? 'Department ownership and archive checks' : '跨部门认领与归档核对'}</a><a href={`${home}guides/radar-evidence-second-check/`}>{lang === 'en' ? 'Second-check Radar evidence' : 'Radar证据人工二次核实'}</a><a href={`${home}guides/brief-format-change-compatibility/`}>{lang === 'en' ? 'Brief format-change compatibility review' : '简报格式改版兼容评审'}</a><a href={`${home}guides/degraded-handoff-go-no-go/`}>{lang === 'en' ? 'Permission before changing handoff paths' : '改变交接方式前许可核对'}</a><a href={`${home}guides/handoff-evidence-audit-checklist/`}>{lang === 'en' ? 'Manual handoff evidence review' : '团队交接证据人工审计'}</a><a href={`${home}guides/cross-device-field-presentation/`}>{lang === 'en' ? 'Cross-device field presentation' : '跨端字段呈现核对'}</a><a href={`${home}guides/audio-route-recovery-matrix/`}>{lang === 'en' ? 'Audio-route recovery source matrix' : '音频切换恢复源码矩阵'}</a><a href={`${home}guides/followup-evidence-minimization/`}>{lang === 'en' ? 'Follow-up evidence minimization' : '客户跟进证据最小化'}</a><a href={`${home}guides/follow-up-context-preflight/`}>{lang === 'en' ? 'Follow-up context and target checks' : '追问指代与目标上下文核对'}</a><a href={`${home}guides/radar-summary-claim-provenance/`}>{lang === 'en' ? 'Sentence-to-field summary provenance' : '人工摘要逐句引用溯源'}</a><a href={`${home}guides/vehicle-exhibition-microphone-preflight/`}>{lang === 'en' ? 'Parked-vehicle and exhibition input preflight' : '停车与展会外设拾音前检'}</a></div>
</section>}
<style>
  .answers-intro { display: grid; grid-template-columns: 1fr 1.3fr; gap: 64px; padding-block: 64px; border-bottom: 1px solid var(--line); }
  .answers-intro h2 { font-size: clamp(26px, 2.6vw, 36px); max-width: 20ch; }
  .answers-intro p, .answers p { color: var(--muted); max-width: 72ch; line-height: 1.8; }
  .answers { padding-block: 72px; border-top: 1px solid var(--line); }
  .answers > h2 { font-size: clamp(28px, 3vw, 40px); }
  .table-hint { display: none; }
  .table-scroll { overflow-x: auto; margin-block: 32px 64px; scrollbar-color: var(--muted) var(--surface); scrollbar-width: thin; }
  table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: start; table-layout: fixed; font-size: 16px; }
  th, td { padding: 20px 24px; border-bottom: 1px solid var(--line); vertical-align: top; text-align: start; overflow-wrap: break-word; }
  th:first-child { width: 23%; padding-left: 0; }
  th:nth-child(2) { width: 33%; }
  td:last-child, th:last-child { padding-right: 0; }
  thead th { color: var(--muted); font-size: 14px; font-weight: 500; }
  tbody td { color: var(--muted); }
  .faq-section { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; }
  .faq-section > h2 { font-size: clamp(28px, 3vw, 40px); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item:first-child { border-top: 1px solid var(--line); }
  summary { padding: 22px 4px; cursor: pointer; color: var(--ink); }
  summary::marker { color: var(--accent); font-size: .8em; }
  summary:hover { color: var(--accent); }
  summary h3 { display: inline; font-size: 18px; font-weight: 600; line-height: 1.6; letter-spacing: -.015em; }
  .faq-answer { padding: 0 4px 24px 22px; scroll-margin-top: 160px; }
  .answer-links { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 40px; }
  .answer-links a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; text-decoration: underline; }
  .answer-links a:hover { color: var(--accent); }
  .answer-links img { filter: invert(1); }
  @media (max-width: 1000px) {
    .answers-intro { gap: 32px; grid-template-columns: 1fr 1.5fr; }
    .faq-section { gap: 32px; grid-template-columns: 1fr; }
    .table-hint { display: block; margin-top: 16px; font-size: 13px; }
  }
  @media (max-width: 700px) {
    .answers-intro { grid-template-columns: 1fr; gap: 20px; padding-block: 40px; }
    .answers-intro h2 { max-width: none; }
    .answers { padding-block: 48px; }
    .table-scroll { margin-block: 24px 48px; }
    summary { padding-block: 20px; }
    summary h3 { font-size: 16px; }
    .faq-answer { padding-left: 0; }
    .answer-links { flex-direction: column; align-items: flex-start; }
  }
</style>
