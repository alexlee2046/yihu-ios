---
import answers from '../data/home-answers.json';
interface Props { lang?: 'zh' | 'en'; part: 'intro' | 'details' }
const { lang = 'zh', part } = Astro.props;
const copy = answers[lang];
const home = lang === 'en' ? '/en/' : '/';
---
{part === 'intro' ? <section class="answers-intro wrap" id="first-answer" aria-labelledby="answer-title">
  <h2 id="answer-title">{copy.heading}</h2>
  <p>{copy.answer}</p>
</section> : <section class="answers wrap" aria-labelledby="capabilities-title">
  <h2 id="capabilities-title">{copy.caption}</h2>
  <p class="table-hint" id="table-hint">{lang === 'en' ? 'Swipe the table to compare prerequisites. With a keyboard, focus the table and use the arrow keys.' : '左右滑动表格，查看完整使用前提。键盘用户可聚焦表格后使用方向键。'}</p>
  <div class="table-scroll" role="region" aria-label={copy.caption} aria-describedby="table-hint" tabindex="0">
    <table>
      <thead><tr>{copy.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
      <tbody>{copy.rows.map(row => <tr id={`capability-${row.id}`}><th scope="row">{row.name}</th><td>{row.scope}</td><td>{row.boundary}</td></tr>)}</tbody>
    </table>
  </div>
  <div class="faq-section">
    <h2 id="faq">{copy.faqHeading}</h2>
    <div class="faq-list">{copy.faqs.map(faq => <details class="faq-item"><summary><h3>{faq.question}</h3></summary><div id={`faq-${faq.id}`} class="faq-answer"><p>{faq.answer}</p></div></details>)}</div>
  </div>
  <div class="answer-links"><a href={`${home}start/`}>{copy.start}<img src="/icons/arrow-up-right.svg" width="18" height="18" alt="" /></a><a href={`${home}privacy/`}>{copy.privacy}<img src="/icons/arrow-up-right.svg" width="18" height="18" alt="" /></a><a href={`${home}guides/voice-workbench-vs-radio-chat/`}>{lang === 'en' ? 'Voice workbench, radio or group chat?' : '工作台、对讲机与语音群聊选型'}</a><a href={`${home}guides/outdoor-store-voice-preflight/`}>{lang === 'en' ? 'Outdoor/store audio checks and text handoff' : '户外与门店：音频预检和文字交接'}</a><a href={`${home}guides/bluetooth-audio-input-troubleshooting/`}>{lang === 'en' ? 'Bluetooth input troubleshooting' : '蓝牙输入分层排障'}</a><a href={`${home}guides/offline-workbench-handoff-troubleshooting/`}>{lang === 'en' ? 'Offline and weak-network handoff' : '离线与弱网交接排障'}</a><a href={`${home}guides/meeting-notes-brief-fields/`}>{lang === 'en' ? 'Reviewable minutes and brief fields' : '可核对纪要与简报字段'}</a><a href={`${home}guides/web-read-aloud-microphone-boundaries/`}>{lang === 'en' ? 'Web read-aloud and microphone transitions' : '网页朗读与麦克风切换边界'}</a><a href={`${home}guides/multi-note-review-handoff/`}>{lang === 'en' ? 'Multiple-note review and candidate to-dos' : '多段笔记汇总与待办核对'}</a><a href={`${home}guides/radar-json-null-validation/`}>{lang === 'en' ? 'Radar JSON types and null checks' : 'Radar JSON类型与空值核对'}</a><a href={`${home}guides/first-trial-go-no-go-checklist/`}>{lang === 'en' ? 'Pre-trial go/no-go decision card' : '首次试用继续/停止评估卡'}</a><a href={`${home}guides/recording-segment-review-labels/`}>{lang === 'en' ? 'Review labels within one recording' : '单录音片段标签与语义核对'}</a><a href={`${home}guides/radar-snapshot-batch-comparison/`}>{lang === 'en' ? 'Compare authorized Radar batches' : 'Radar同源批次人工比较'}</a><a href={`${home}guides/noisy-transcript-text-correction/`}>{lang === 'en' ? 'Manual text correction and retained copies' : '人工文本修订与副本核对'}</a><a href={`${home}guides/department-minutes-ownership-archive/`}>{lang === 'en' ? 'Department ownership and archive checks' : '跨部门认领与归档核对'}</a><a href={`${home}guides/radar-evidence-second-check/`}>{lang === 'en' ? 'Second-check Radar evidence' : 'Radar证据人工二次核实'}</a><a href={`${home}guides/brief-format-change-compatibility/`}>{lang === 'en' ? 'Brief format-change compatibility review' : '简报格式改版兼容评审'}</a><a href={`${home}guides/degraded-handoff-go-no-go/`}>{lang === 'en' ? 'Permission before changing handoff paths' : '改变交接方式前许可核对'}</a><a href={`${home}guides/handoff-evidence-audit-checklist/`}>{lang === 'en' ? 'Manual handoff evidence review' : '团队交接证据人工审计'}</a><a href={`${home}guides/cross-device-field-presentation/`}>{lang === 'en' ? 'Cross-device field presentation' : '跨端字段呈现核对'}</a><a href={`${home}guides/audio-route-recovery-matrix/`}>{lang === 'en' ? 'Audio-route recovery source matrix' : '音频切换恢复源码矩阵'}</a><a href={`${home}guides/followup-evidence-minimization/`}>{lang === 'en' ? 'Follow-up evidence minimization' : '客户跟进证据最小化'}</a><a href={`${home}guides/follow-up-context-preflight/`}>{lang === 'en' ? 'Follow-up context and target checks' : '追问指代与目标上下文核对'}</a><a href={`${home}guides/radar-summary-claim-provenance/`}>{lang === 'en' ? 'Sentence-to-field summary provenance' : '人工摘要逐句引用溯源'}</a><a href={`${home}guides/vehicle-exhibition-microphone-preflight/`}>{lang === 'en' ? 'Parked-vehicle and exhibition input preflight' : '停车与展会外设拾音前检'}</a><a href={`${home}guides/multilingual-terms-preflight/`}>{lang === 'en' ? 'Mixed-language term preflight' : '多语术语保留前检'}</a><a href={`${home}guides/timezone-timestamp-review/`}>{lang === 'en' ? 'Timezone and timestamp review' : '跨时区日期时间核对'}</a><a href={`${home}guides/carrier-redaction-archive-matrix/`}>{lang === 'en' ? 'Carrier-specific redaction/archive scope' : '载体脱敏归档范围矩阵'}</a><a href={`${home}guides/export-encoding-delimiter-preflight/`}>{lang === 'en' ? 'Export encoding and delimiter checks' : '导出编码与分隔符前检'}</a><a href={`${home}guides/microphone-permission-sample-contract/`}>{lang === 'en' ? 'Microphone permission and sample contract' : '麦克风权限与采样契约'}</a><a href={`${home}guides/batch-change-record-retention/`}>{lang === 'en' ? 'Batch-change material retention mapping' : '批次改版材料归档链'}</a><a href={`${home}guides/empty-field-display-defaults/`}>{lang === 'en' ? 'Empty fields and display defaults' : '空字段与显示默认值'}</a><a href={`${home}guides/foreground-audio-rebind-preflight/`}>{lang === 'en' ? 'Foreground audio/state preflight' : '返回前台音频状态前检'}</a><a href={`${home}guides/multi-role-approval-receipt-checklist/`}>{lang === 'en' ? 'Multi-role approval and receipt boundaries' : '多角色审批与签收边界'}</a><a href={`${home}guides/share-batch-item-preflight/`}>{lang === 'en' ? 'Batch item preflight' : '批次逐项前检'}</a><a href={`${home}guides/interruption-recapture-preflight/`}>{lang === 'en' ? 'Before recapture' : '中断后重录前检'}</a><a href={`${home}guides/history-retrieval-manual-comparison/`}>{lang === 'en' ? 'History retrieval scope' : '历史检索比对范围'}</a><a href={`${home}guides/notification-payload-model-preflight/`}>{lang === 'en' ? 'Notification model preflight' : '通知负载模型前检'}</a><a href={`${home}guides/pcm-format-admission-review/`}>{lang === 'en' ? 'PCM format admission' : 'PCM格式准入'}</a><a href={`${home}guides/reply-request-receipt-mapping/`}>{lang === 'en' ? 'Reply request/receipt mapping' : '回复请求与回执对应'}</a><a href={`${home}guides/evidence-link-admission-preflight/`}>{lang === 'en' ? 'Evidence link admission' : '证据链接准入'}</a><a href={`${home}guides/capture-buffer-pressure-checklist/`}>{lang === 'en' ? 'Capture queue pressure' : '录音队列压力核对'}</a><a href={`${home}guides/note-audio-text-evidence-mapping/`}>{lang === 'en' ? 'Audio/text evidence mapping' : '音文材料归档对应'}</a><a href={`${home}guides/radar-feed-url-boundary-preflight/`}>{lang === 'en' ? 'Feed URL boundaries' : 'Radar源URL边界'}</a><a href={`${home}guides/near-field-policy-route-review/`}>{lang === 'en' ? 'Near-field policy versus route' : '近讲策略与实际路由'}</a><a href={`${home}guides/note-segment-join-provenance/`}>{lang === 'en' ? 'Segment joining provenance' : '分段拼接处理范围'}</a><a href={`${home}guides/reply-transport-budget-preflight/`}>{lang === 'en' ? 'Reply transport budgets' : '回复传输预算'}</a><a href={`${home}guides/voiceprint-filter-not-authorization/`}>{lang === 'en' ? 'Voiceprint is not authority' : '声纹过滤非认证'}</a><a href={`${home}guides/status-alias-approval-boundaries/`}>{lang === 'en' ? 'Raw status and display aliases' : '原状态与展示别名'}</a><a href={`${home}guides/history-reference-integrity-review/`}>{lang === 'en' ? 'History reference integrity' : '历史引用结构'}</a><a href={`${home}guides/capture-completion-token-review/`}>{lang === 'en' ? 'Capture completion tokens' : '采集完成令牌'}</a><a href={`${home}guides/reply-draft-restoration-scope/`}>{lang === 'en' ? 'Reply draft restoration scope' : '回复草稿恢复范围'}</a><a href={`${home}guides/source-switch-cache-isolation/`}>{lang === 'en' ? 'Source-switch cache isolation' : '切源缓存隔离'}</a><a href={`${home}guides/audio-level-not-accuracy-review/`}>{lang === 'en' ? 'Audio meters are not accuracy' : '音量电平非准确率'}</a><a href={`${home}guides/note-removal-retention-boundaries/`}>{lang === 'en' ? 'Note removal and retention scope' : '笔记移除与保留范围'}</a><a href={`${home}guides/note-radar-draft-candidate-preflight/`}>{lang === 'en' ? 'Radar draft candidate preflight' : 'Radar草稿候选前检'}</a><a href={`${home}guides/audio-recovery-debounce-boundaries/`}>{lang === 'en' ? 'Recovery debounce scope' : '恢复去抖窗口范围'}</a><a href={`${home}guides/local-file-protection-scope/`}>{lang === 'en' ? 'Local file protection scope' : '本地文件保护范围'}</a><a href={`${home}guides/attention-filter-identity-boundaries/`}>{lang === 'en' ? 'Attention filter is not identity' : '提到我非身份认领'}</a><a href={`${home}guides/pcm-stream-end-boundaries/`}>{lang === 'en' ? 'PCM block/end-of-stream boundaries' : 'PCM块与流结束边界'}</a><a href={`${home}guides/share-manifest-visibility-review/`}>{lang === 'en' ? 'Share manifest visibility' : '分享清单可见点'}</a><a href={`${home}guides/workbench-origin-page-boundaries/`}>{lang === 'en' ? 'Origin, page and storage scope' : 'origin页面与存储范围'}</a><a href={`${home}guides/replaceable-voice-preview-review/`}>{lang === 'en' ? 'Replaceable voice previews' : '可替换语音预览'}</a><a href={`${home}guides/model-artifact-validation-evidence/`}>{lang === 'en' ? 'Model artifact validation evidence' : '模型资产校验证据'}</a><a href={`${home}guides/host-bridge-outcome-boundaries/`}>{lang === 'en' ? 'Host bridge outcome boundaries' : '页面桥回执边界'}</a><a href={`${home}guides/audio-busy-state-admission/`}>{lang === 'en' ? 'Audio busy-state admission' : '音频忙态分层'}</a><a href={`${home}guides/history-generation-receipt-priority/`}>{lang === 'en' ? 'History generations and receipts' : '历史代际与回执优先级'}</a></div>
</section>}
<style>
  .answers-intro { display: grid; grid-template-columns: 1fr 1.3fr; gap: 64px; padding-block: 64px; border-bottom: 1px solid var(--line); }
  .answers-intro h2 { font-size: clamp(26px, 2.6vw, 36px); max-width: 20ch; }
  .answers-intro p, .answers p { color: var(--muted); max-width: 72ch; line-height: 1.8; }
  .answers { padding-block: 72px; border-top: 1px solid var(--line); }
  .answers > h2 { font-size: clamp(28px, 3vw, 40px); }
  .table-hint { display: none; }
  .table-scroll { overflow-x: auto; margin-block: 32px 64px; scrollbar-color: var(--muted) var(--surface); scrollbar-width: thin; }
  table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: start; table-layout: fixed; font-size: 16px; }
  th, td { padding: 20px 24px; border-bottom: 1px solid var(--line); vertical-align: top; text-align: start; overflow-wrap: break-word; }
  th:first-child { width: 23%; padding-left: 0; }
  th:nth-child(2) { width: 33%; }
  td:last-child, th:last-child { padding-right: 0; }
  thead th { color: var(--muted); font-size: 14px; font-weight: 500; }
  tbody td { color: var(--muted); }
  .faq-section { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; }
  .faq-section > h2 { font-size: clamp(28px, 3vw, 40px); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item:first-child { border-top: 1px solid var(--line); }
  summary { padding: 22px 4px; cursor: pointer; color: var(--ink); }
  summary::marker { color: var(--accent); font-size: .8em; }
  summary:hover { color: var(--accent); }
  summary h3 { display: inline; font-size: 18px; font-weight: 600; line-height: 1.6; letter-spacing: -.015em; }
  .faq-answer { padding: 0 4px 24px 22px; scroll-margin-top: 160px; }
  .answer-links { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 40px; }
  .answer-links a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; text-decoration: underline; }
  .answer-links a:hover { color: var(--accent); }
  .answer-links img { filter: invert(1); }
  @media (max-width: 1000px) {
    .answers-intro { gap: 32px; grid-template-columns: 1fr 1.5fr; }
    .faq-section { gap: 32px; grid-template-columns: 1fr; }
    .table-hint { display: block; margin-top: 16px; font-size: 13px; }
  }
  @media (max-width: 700px) {
    .answers-intro { grid-template-columns: 1fr; gap: 20px; padding-block: 40px; }
    .answers-intro h2 { max-width: none; }
    .answers { padding-block: 48px; }
    .table-scroll { margin-block: 24px 48px; }
    summary { padding-block: 20px; }
    summary h3 { font-size: 16px; }
    .faq-answer { padding-left: 0; }
    .answer-links { flex-direction: column; align-items: flex-start; }
  }
</style>
