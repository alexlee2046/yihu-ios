---
<article class="document decisions-guide">
  <style is:inline>
    .decisions-guide { max-width:1120px; }
    .decisions-guide > h1 { max-width:25ch; font-size:clamp(36px,4vw,56px); }
    .decisions-guide > p, .decisions-guide > ul { max-width:78ch; }
    .decisions-guide nav { display:flex; flex-wrap:wrap; gap:8px 24px; padding-block:16px; }
    .decisions-guide nav a { display:inline-flex; align-items:center; min-height:44px; }
    .decisions-guide .table-region { overflow-x:auto; }
    .decisions-guide table { width:100%; min-width:940px; table-layout:fixed; border-collapse:collapse; text-align:start; }
    .decisions-guide th, .decisions-guide td { padding:16px; border-bottom:1px solid var(--line); vertical-align:top; overflow-wrap:anywhere; text-align:start; }
    .decisions-guide th { font-weight:600; }
    .decisions-guide th:first-child { width:26%; }
    .decisions-guide td { color:var(--muted); }
    .decisions-guide caption { text-align:start; margin-bottom:12px; }
    .decisions-guide .table-hint { font-size:13px; }
    .decisions-guide pre { white-space:pre; overflow-x:auto; overflow-wrap:normal; padding:16px; background:var(--surface); border-radius:8px; font-family:ui-monospace, SFMono-Regular, Menlo, monospace; font-size:14px; line-height:1.7; }
    .decisions-guide pre code { display:block; padding:0; background:transparent; }
  </style>
  <h1>{copy.title}</h1>
  <p class="lead">{copy.lead}</p>
  {conversion && <section class="guide-conversion" data-guide-conversion aria-label={en ? 'Try a sample or view the store edition' : '先试示例或查看商店版'}>
    <p>{conversion.sourceContext}</p>
    <div class="hero-actions"><a class="button button-primary" href={conversion.demoHref}>{conversion.demoLabel}</a><a class="button button-text app-store-link" href={conversion.storeHref}>{conversion.storeLabel}</a></div>
    <p>{conversion.storeContext}</p>
