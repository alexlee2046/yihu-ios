---
import { guideConversion } from '../lib/conversion-events';
interface Props { lang?: 'zh' | 'en' }
const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const conversion = guideConversion(Astro.url.pathname);
const decisionsCopy = {
  "zh": {
    "title": "手机查看 Agent 待决策与待验收：先读，再确认",
    "lead": "一呼 PM Radar 从你自己的 JSON 导出或兼容 HTTPS 数据源读取台账，按工作台筛选事项；读到一条任务不代表已经授权回复，更不代表任务已执行。下面用两条合成记录解释筛选、来源时效、手机确认与回执边界；Watch 是配对 iPhone 的伴侣，不是独立审批入口。",
    "nav": "移动决策指南导航",
    "exampleTitle": "最小合成 JSON：不是一个在线服务",
    "exampleIntro": "本例仅有 demo 项目的两条合成事项。example.invalid 不可作为服务入口；reply_supported=false 将样例标为不支持回复，不能代替服务端授权。date_str 固定为演示时点，不会跟着网页时间更新；日后导入可能显示过期，这不是让样例冒充实时台账的理由。不要把私有台账或带凭据的 feed 放到公开网站。",
    "exampleDetails": "date_str、decisions、active、stale、cold 是快照字段；tasks 在本例同时列出两条记录，避免旧导出缺少完整台账时的不完整提示。原始 status 保留“等你决策 / 等你验收”，不把展示语言翻译当成新的源状态。此例不含令牌、账号、真实条目或可写服务。",
    "filterTitle": "同一份样例，筛选前后有什么变化？",
    "tableHint": "左右滑动查看全部列；键盘用户可聚焦表格后用方向键阅读。",
    "filterColumns": [
      "视图 / 操作",
      "样例结果",
      "应如何理解"
    ],
    "filters": [
